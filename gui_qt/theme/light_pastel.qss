/* ==========================================================================
   KeyMacro — Light & Pastel Theme (Soft White, Lavender & Blush Accents)
   ========================================================================== */

/* Global Reset */
* {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
    color: #1E293B;
}

QMainWindow, QWidget#CentralWidget {
    background-color: #F8F9FD;
}

QDialog, QMessageBox {
    background-color: #FFFFFF;
    color: #1E293B;
}

QMessageBox QLabel {
    color: #1E293B;
}

/* Sidebar */
QFrame#SidebarFrame {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

QLabel#SidebarBrand {
    font-size: 16px;
    font-weight: bold;
    color: #4C1D95;
    padding: 12px 16px;
}

QLabel#SidebarSubtitle {
    font-size: 11px;
    color: #64748B;
    padding-left: 16px;
    padding-bottom: 8px;
}

/* Nav Buttons */
QPushButton#NavButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #475569;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
}

QPushButton#NavButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QPushButton#NavButton:checked, QPushButton#NavButton[active="true"] {
    background-color: #EDE9FE;
    color: #6D28D9;
    border-left: 3px solid #7C3AED;
    font-weight: bold;
}

/* Top Header Bar */
QFrame#TopHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 48px;
    max-height: 54px;
}

QLabel#PageTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1E293B;
}

/* Card Containers */
QFrame#Card, QFrame.Card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame#MetricCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 8px;
}

QLabel#MetricValue {
    font-size: 24px;
    font-weight: bold;
    color: #7C3AED;
}

QLabel#MetricLabel {
    font-size: 12px;
    color: #64748B;
}

/* Standard Buttons */
QPushButton {
    background-color: #F8FAFC;
    border: 1.5px solid #94A3B8;
    border-radius: 8px;
    color: #1E293B;
    font-weight: 600;
    padding: 7px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #EDE9FE;
    border-color: #7C3AED;
    color: #4C1D95;
}

QPushButton:pressed {
    background-color: #DDD6FE;
    border-color: #6D28D9;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    color: #94A3B8;
}

/* Accent Button (Lavender / Violet) */
QPushButton#PrimaryBtn {
    background-color: #7C3AED;
    border: 1.5px solid #5B21B6;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#PrimaryBtn:hover {
    background-color: #8B5CF6;
    border-color: #4C1D95;
}

QPushButton#PrimaryBtn:pressed {
    background-color: #5B21B6;
}

/* Success Button (Run Macro) */
QPushButton#SuccessBtn {
    background-color: #10B981;
    border: 1.5px solid #059669;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#SuccessBtn:hover {
    background-color: #34D399;
    border-color: #047857;
}

QPushButton#SuccessBtn:pressed {
    background-color: #047857;
}

/* Danger / Record Button (Blush Red) */
QPushButton#DangerBtn, QPushButton#RecordBtn {
    background-color: #E11D48;
    border: 1.5px solid #BE123C;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#DangerBtn:hover, QPushButton#RecordBtn:hover {
    background-color: #F43F5E;
    border-color: #9F1239;
}

QPushButton#DangerBtn:pressed, QPushButton#RecordBtn:pressed {
    background-color: #9F1239;
}

/* Stop Button */
QPushButton#StopBtn {
    background-color: #475569;
    border: 1.5px solid #1E293B;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#StopBtn:hover {
    background-color: #64748B;
}

/* Theme Toggle Button */
QPushButton#ThemeToggleBtn {
    background-color: #EDE9FE;
    border: 1.5px solid #7C3AED;
    border-radius: 16px;
    padding: 5px 14px;
    font-weight: 600;
    color: #6D28D9;
}

QPushButton#ThemeToggleBtn:hover {
    background-color: #DDD6FE;
    border-color: #5B21B6;
}

/* Voice Toggle Pill */
QPushButton#VoiceToggleBtn {
    background-color: #ECFDF5;
    border: 1.5px solid #10B981;
    border-radius: 16px;
    padding: 5px 14px;
    font-weight: 600;
    color: #047857;
}

QPushButton#VoiceToggleBtn:hover {
    background-color: #D1FAE5;
    border-color: #059669;
}

/* Text Inputs and Editors */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #94A3B8;
    border-radius: 8px;
    color: #1E293B;
    padding: 8px 12px;
    selection-background-color: #EDE9FE;
    selection-color: #4C1D95;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #64748B;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #7C3AED;
    background-color: #FFFFFF;
}

/* Tables and Tree Views */
QTableWidget, QTreeView, QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #1E293B;
    gridline-color: #F1F5F9;
    selection-background-color: #EDE9FE;
    selection-color: #4C1D95;
}

QTableWidget::item, QTreeView::item, QListWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:selected, QTreeView::item:selected, QListWidget::item:selected {
    background-color: #EDE9FE;
    color: #4C1D95;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    font-weight: bold;
    font-size: 12px;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* Status Bar */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    color: #64748B;
    min-height: 28px;
}

QStatusBar QLabel {
    color: #64748B;
    font-size: 12px;
    padding: 0 8px;
}

/* Risk Badges */
QLabel#BadgeLow {
    background-color: #DCFCE7;
    color: #15803D;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#BadgeMedium {
    background-color: #FEF3C7;
    color: #B45309;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#BadgeHigh {
    background-color: #FFE4E6;
    color: #BE123C;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#HotkeyPill {
    background-color: #F3E8FF;
    color: #6B21A8;
    border: 1px solid #DDD6FE;
    border-radius: 6px;
    padding: 2px 8px;
    font-family: "Consolas", monospace;
    font-size: 11px;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #F8FAFC;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* Context Menus & Popups */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px;
    color: #1E293B;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 22px 6px 12px;
    border-radius: 6px;
    color: #1E293B;
}

QMenu::item:selected {
    background-color: #EDE9FE;
    color: #4C1D95;
}

QMenu::item:disabled {
    color: #94A3B8;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    border-radius: 8px;
    padding: 6px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    margin-right: 3px;
}

QTabBar::tab:hover {
    background-color: #E2E8F0;
    color: #1E293B;
}

QTabBar::tab:selected {
    background-color: #EDE9FE;
    color: #6D28D9;
    border-color: #C4B5FD;
    font-weight: bold;
}

/* Combo Boxes & Dropdowns */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #1E293B;
    padding: 6px 12px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #7C3AED;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #1E293B;
    selection-background-color: #EDE9FE;
    selection-color: #4C1D95;
    outline: none;
}

/* Radio Buttons & Checkboxes */
QRadioButton, QCheckBox {
    color: #1E293B;
    font-size: 13px;
    font-weight: 600;
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #CBD5E1;
    background-color: #FFFFFF;
    border-radius: 8px;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #7C3AED;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #7C3AED;
    border-color: #7C3AED;
}

/* Tooltips */
QToolTip {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* Scroll Areas */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Parameter Cards in Dialogs */
QFrame#ParamCard {
    background-color: #F8FAFC;
    border: 1.5px solid #CBD5E1;
    border-radius: 10px;
}

